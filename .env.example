# Discord bot (Phase 2+)
DISCORD_TOKEN=

# Solana RPC — any standard JSON-RPC / WS endpoint works (public, or a paid provider's)
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com

# Helius — optional low-latency Enhanced WebSocket provider (LaserStream-backed).
# Leave blank to run on the native Solana RPC WebSocket alone.
HELIUS_API_KEY=

# Database (Phase 2+)
DATABASE_URL=postgresql+asyncpg://snipe_rugg:snipe_rugg@localhost:5432/snipe_rugg

# Redis — dedup / live state / queues / cache
REDIS_URL=redis://localhost:6379/0

# Market data / token metadata providers (Phase 3+)
PUMP_API_KEY=
DEX_API_KEY=

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
